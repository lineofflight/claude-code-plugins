{
  "description": "Tint pane background when Claude is working.",
  "hooks": {
    "UserPromptSubmit": [{
      "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/tint.sh working" }]
    }],
    "PreToolUse": [{
      "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/tint.sh working" }]
    }],
    "Notification": [{
      "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/tint.sh waiting" }]
    }],
    "Stop": [{
      "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/tint.sh waiting" }]
    }]
  }
}
